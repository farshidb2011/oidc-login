{
  "name": "oidc-login-plugin",
  "version": "2.0.0",
  "description": "A configurable Vue 3 plugin that adds router guards, axios interceptors, and pinia integration.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch"
  },
  "keywords": [
    "vue",
    "vue3",
    "plugin",
    "pinia",
    "axios",
    "vue-router"
  ],
  "author": "Farshid Bahadori",
  "license": "ّISC",
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "oidc-client-ts": "^3.4.0"
  },
  "peerDependencies": {
    "axios": "^1.5.0",
    "oidc-client-ts": "^3.4.0",
    "pinia": "^3.0.3",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "tsup": "^7.2.0",
    "typescript": "^5.4.0",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}